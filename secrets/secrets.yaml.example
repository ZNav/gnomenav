# Plaintext TEMPLATE only. The real file is `secrets/secrets.yaml`, ENCRYPTED with
# sops (safe to commit once encrypted). Never commit this plaintext version filled in.
#
# Create the encrypted file:
#   cp secrets/secrets.yaml.example secrets/secrets.yaml
#   sops secrets/secrets.yaml     # edit; sops encrypts on save
nextcloud_db_password: "NEXTCLOUD_DB_PASSWORD=change-me"
immich_db_password: "DB_PASSWORD=change-me"
spotify_env: |
  SPOTIFY_CLIENT_ID=xxxx
  SPOTIFY_CLIENT_SECRET=xxxx
cloudflared_token: "paste-tunnel-credentials-json-here"
