# Copy to .env and fill in real values. Never commit .env.
# Lives at /home/znav/nas/.env on msi.

# ── Cloudflare Zero Trust tunnel ────────────────────────────────────────────
CF_TUNNEL_TOKEN=

# ── DuckDNS (legacy / fallback dynamic DNS) ─────────────────────────────────
DUCKDNS_SUBDOMAINS=
DUCKDNS_TOKEN=

# ── WireGuard (Mullvad VPN for the *arr/qbittorrent stack) ──────────────────
WG_ADDRESS=
WG_ENDPOINT=
WG_PRIVKEY=
WG_PUBKEY=

# ── Wiki.js (couple-shared knowledge base, postgres backend) ────────────────
WIKIJS_DB_PASSWORD=

# ── Wanderer (memories.gnomenav.com) ────────────────────────────────────────
WANDERER_KEY=

# ── Spotify (for spotdl music ingestion into navidrome) ─────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Media library bind paths ────────────────────────────────────────────────
# These are host paths the compose services bind-mount.
# Most live under the x220 NFS mount (/mnt/x220).
BOOKS_DIR=/mnt/x220/files/books
DOWNLOADS_DIR=/mnt/x220/downloads
MOVIES_DIR=/mnt/x220/media/movies
SHOWS_DIR=/mnt/x220/media/shows
MUSIC_DIR=/mnt/x220/media/music
PHOTOS_DIR=/mnt/x220/media/photos
OTHERS_DIR=/mnt/x220/media/other
PORN_DIR=
